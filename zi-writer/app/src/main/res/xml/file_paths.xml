<?xml version="1.0" encoding="utf-8"?>
<!--
  Конфигурация FileProvider для безопасного доступа к файлам.
  Используется для передачи APK-файлов в системный инсталлятор.
-->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Внешние файлы приложения (для APK обновлений) -->
    <external-files-path
        name="external_files"
        path="." />
    
    <!-- Публичная папка Downloads -->
    <external-path
        name="external"
        path="." />
    
    <!-- Кэш приложения -->
    <cache-path
        name="cache"
        path="." />
    
    <!-- Внутренние файлы приложения -->
    <files-path
        name="internal_files"
        path="." />
</paths>
